<UserControl x:Class="Flow.Launcher.Plugin.UniqueNamesGenerator.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420"
             PreviewMouseWheel="OnPreviewMouseWheel"
             RequestBringIntoView="OnRequestBringIntoView">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TableBorder" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="RowDivider" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="RowHover" Color="#14000000"/>

        <Style x:Key="CompactSliderStyle"
               TargetType="Slider"
               BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Width" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="9"
                                Background="#3A3A3A"
                                BorderBrush="#6A6A6A"
                                BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#EAEAEA"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModeBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#5A5A5A"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="82"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CFCFCF"/>
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9E9E9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDDDDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBd" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GroupHeaderTemplate">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=GroupBox}, Path=Header}"
                           Style="{StaticResource SectionHeaderTextStyle}"/>
                <Button Style="{StaticResource InfoButtonStyle}"
                        Content="i"
                        ToolTip="{Binding RelativeSource={RelativeSource AncestorType=GroupBox}, Path=Tag}"
                        ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="60000"/>
            </DockPanel>
        </DataTemplate>

        <ControlTemplate x:Key="SectorGroupBoxTemplate" TargetType="GroupBox">
            <Border CornerRadius="10"
                    BorderThickness="4"
                    BorderBrush="#5A5A5A"
                    Background="Transparent"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ContentPresenter Grid.Row="0"
                                      ContentSource="Header"
                                      Margin="0,0,0,8"/>

                    <ContentPresenter Grid.Row="1"
                                      ContentSource="Content"/>
                </Grid>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Changes are saved automatically."
                   Margin="18,0,0,8"
                   Foreground="#888"/>

        <Grid x:Name="LayoutGrid" Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Col0" Width="1.15*"/>
                <ColumnDefinition x:Name="Col1" Width="1.15*"/>
                <ColumnDefinition x:Name="Col2" Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ColA" Grid.Column="0" Margin="6,0,6,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" ClipToBounds="True">

                <GroupBox Header="Custom endings"
                         HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                         Template="{StaticResource SectorGroupBoxTemplate}"
                         Tag="Custom endings are optional suffixes added to the generated username (for example: @gmail.com). You will still have the option to pick the plain username without any ending."
                         Margin="0,0,0,14"
                         HorizontalAlignment="Stretch">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="UseEndingsBox" Content="Enable custom endings" Margin="0,0,0,8"/>

                        <StackPanel x:Name="EndingsPanel">
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <Button x:Name="AddEndingBtn" Content="Add" Width="72" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                <TextBox x:Name="NewEndingBox" MaxLength="100"/>
                            </DockPanel>

                            <Border BorderBrush="{StaticResource TableBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="220"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="8,6,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="#" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Value" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Actions" Foreground="#AAA" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Border Grid.Row="0" Height="1" Background="{StaticResource RowDivider}" VerticalAlignment="Bottom" Opacity="0.8"/>

                                    <Grid Grid.Row="1">
                                        <ListView x:Name="EndingsListView"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Padding="0"
                                                  Margin="0"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.CanContentScroll="False"
                                                  IsTabStop="False">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="5"/>
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>

                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="6,0">
                                                        <DockPanel LastChildFill="True">
                                                            <StackPanel DockPanel.Dock="Right"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center">
                                                                <Button Width="56"
                                                                        Height="28"
                                                                        Margin="0,0,6,0"
                                                                        Style="{StaticResource ActionButtonStyle}"
                                                                        Background="#2B6CB0"
                                                                        Tag="{Binding Index}"
                                                                        Click="OnEditEndingClicked"
                                                                        ToolTip="Edit">
                                                                    <Image Width="16"
                                                                           Height="16"
                                                                           Source="{Binding DataContext.EditIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           Stretch="Uniform"/>
                                                                </Button>

                                                                <Button Width="56"
                                                                        Height="28"
                                                                        Style="{StaticResource ActionButtonStyle}"
                                                                        Background="#E96B6B"
                                                                        Tag="{Binding Index}"
                                                                        Click="OnRemoveEndingClicked"
                                                                        ToolTip="Delete">
                                                                    <Image Width="16"
                                                                           Height="16"
                                                                           Source="{Binding DataContext.DeleteIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           Stretch="Uniform"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Text="{Binding No}"
                                                                           Foreground="#9AA0A6"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Left"
                                                                           Margin="2,0,6,0"/>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Value}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="#EAEAEA"
                                                                           Margin="0,0,10,0"/>
                                                            </Grid>
                                                        </DockPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <TextBlock x:Name="NoEndingsText"
                                                   Text="No endings yet."
                                                   Foreground="#888"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>

                                    <StackPanel x:Name="PagerPanel"
                                                Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="8,6,8,6">
                                        <Button x:Name="PrevPageBtn" Style="{StaticResource PagerButtonStyle}">
                                            <Viewbox Width="16" Height="16">
                                                <Image Source="{Binding DataContext.ArrowIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Stretch="Uniform"
                                                       SnapsToDevicePixels="True"/>
                                            </Viewbox>
                                        </Button>

                                        <TextBlock x:Name="PageText"
                                                   Foreground="#AAA"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"/>

                                        <Button x:Name="NextPageBtn" Style="{StaticResource PagerButtonStyle}">
                                            <Viewbox Width="16" Height="16">
                                                <Image Source="{Binding DataContext.ArrowIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Stretch="Uniform"
                                                       SnapsToDevicePixels="True"
                                                       RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <ScaleTransform ScaleX="-1"/>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Parts"
                         HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                         Template="{StaticResource SectorGroupBoxTemplate}"
                         Tag="Controls how many word parts are used in the username. If Min equals Max, the parts count is fixed."
                         Margin="0,0,0,14"
                         HorizontalAlignment="Stretch">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Min" VerticalAlignment="Center"/>
                            <Slider x:Name="MinPartsSlider"
                                    Grid.Column="1"
                                    Style="{StaticResource CompactSliderStyle}"
                                    Minimum="1"
                                    Maximum="5"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"/>
                            <TextBlock x:Name="MinPartsValue"
                                       Grid.Column="2"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Max" VerticalAlignment="Center"/>
                            <Slider x:Name="MaxPartsSlider"
                                    Grid.Column="1"
                                    Style="{StaticResource CompactSliderStyle}"
                                    Minimum="1"
                                    Maximum="5"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"/>
                            <TextBlock x:Name="MaxPartsValue"
                                       Grid.Column="2"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

            <StackPanel x:Name="ColB" Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" ClipToBounds="True">

                <GroupBox Header="Formatting"
                         HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                         Template="{StaticResource SectorGroupBoxTemplate}"
                         Tag="If you select one option, the mode is FIXED. If you select multiple options, the mode is RANDOM."
                         Margin="0,0,0,14"
                         HorizontalAlignment="Stretch">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Case" Width="80" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource ModeBadgeBorderStyle}">
                                    <TextBlock x:Name="CaseModeText" Style="{StaticResource ModeBadgeTextStyle}"/>
                                </Border>
                            </StackPanel>

                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <CheckBox x:Name="CaseRandPascal" Content="Pascal" Margin="0,0,12,0"/>
                                <CheckBox x:Name="CaseRandCamel" Content="camel" Margin="0,0,12,0"/>
                                <CheckBox x:Name="CaseRandLower" Content="lower"/>
                            </WrapPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Separator" Width="80" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource ModeBadgeBorderStyle}">
                                    <TextBlock x:Name="SepModeText" Style="{StaticResource ModeBadgeTextStyle}"/>
                                </Border>
                            </StackPanel>

                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <CheckBox x:Name="SepRandNone" Content="None" Margin="0,0,12,0"/>
                                <CheckBox x:Name="SepRandUnderscore" Content="_" Margin="0,0,12,0"/>
                                <CheckBox x:Name="SepRandDot" Content="." Margin="0,0,12,0"/>
                                <CheckBox x:Name="SepRandDash" Content="-"/>
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Numbers"
                         HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                         Template="{StaticResource SectorGroupBoxTemplate}"
                         Tag="Adds digits to the username. Use Position to place digits at the front, at the end, or both. Min and Max control how many digits are used."
                         Margin="0,0,0,14"
                         HorizontalAlignment="Stretch">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="UseNumbersBox" Content="Use numbers" Margin="0,0,0,10"/>

                        <StackPanel x:Name="NumbersPanel">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Min" VerticalAlignment="Center"/>
                                <Slider x:Name="MinDigitsSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource CompactSliderStyle}"
                                        Minimum="1"
                                        Maximum="10"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"/>
                                <TextBlock x:Name="MinDigitsValue"
                                           Grid.Column="2"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Max" VerticalAlignment="Center"/>
                                <Slider x:Name="MaxDigitsSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource CompactSliderStyle}"
                                        Minimum="1"
                                        Maximum="10"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"/>
                                <TextBlock x:Name="MaxDigitsValue"
                                           Grid.Column="2"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Position" VerticalAlignment="Center"/>
                                <ComboBox x:Name="NumberPositionCombo" Grid.Column="1" MinWidth="160"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Word structure"
                         HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                         Template="{StaticResource SectorGroupBoxTemplate}"
                         Tag="Controls the probability that the username ends with two nouns."
                         Margin="0,0,0,14"
                         HorizontalAlignment="Stretch">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="DoubleNounTailBox" Content="Allow two nouns at the end" Margin="0,0,0,10"/>

                        <Grid x:Name="ChancePanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Chance %" VerticalAlignment="Center"/>
                            <Slider x:Name="DoubleNounChanceSlider"
                                    Grid.Column="1"
                                    Style="{StaticResource CompactSliderStyle}"
                                    Minimum="10"
                                    Maximum="100"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"/>
                            <TextBlock x:Name="DoubleNounChanceValue"
                                       Grid.Column="2"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <StackPanel x:Name="ColBExtra" />

            </StackPanel>

            <StackPanel x:Name="ColCPanel" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" ClipToBounds="True">

                <GroupBox x:Name="EnterActionGroup"
                         Header="Enter action"
                         HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                         Template="{StaticResource SectorGroupBoxTemplate}"
                         Tag="Choose what happens when you press Enter: Copy will copy the result. Copy and Paste will copy it and then paste using Ctrl+V."
                         Margin="0,0,0,14"
                         HorizontalAlignment="Stretch">
                    <StackPanel Margin="10">
                        <RadioButton x:Name="EnterCopyRadio" Content="Copy" GroupName="EnterAction" Margin="0,0,0,6"/>
                        <RadioButton x:Name="EnterCopyPasteRadio" Content="Copy and Paste" GroupName="EnterAction"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="DictionaryGroup"
                         Header="Dictionary"
                         HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                         Template="{StaticResource SectorGroupBoxTemplate}"
                         Tag="Controls the words source file (words.json by default). Use Reload to re-read the file from the plugin folder."
                         Margin="0,0,0,14"
                         HorizontalAlignment="Stretch">
                    <StackPanel Margin="10">
                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                            <Button x:Name="ReloadBtn" Content="Reload" Width="80" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <TextBox x:Name="WordsFileBox"/>
                        </DockPanel>
                        <CheckBox x:Name="ShowReloadActionBox" Content="Show reload action in results"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="BatchGroup"
                         Header="Batch output"
                         HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                         Template="{StaticResource SectorGroupBoxTemplate}"
                         Tag="Adds an optional action to generate multiple usernames at once. You can set the default count, enforce uniqueness, and choose the output format."
                         Margin="0,0,0,14"
                         HorizontalAlignment="Stretch">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="ShowBatchActionBox" Content="Show batch action in results" Margin="0,0,0,10"/>

                        <StackPanel x:Name="BatchPanel">
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <TextBlock Text="Default count" VerticalAlignment="Center" DockPanel.Dock="Left" Width="90"/>
                                <TextBox x:Name="BatchCountBox" Width="70" HorizontalAlignment="Left"/>
                            </DockPanel>

                            <CheckBox x:Name="UniqueBatchBox" Content="Ensure unique usernames" Margin="0,0,0,8"/>

                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Format" VerticalAlignment="Center" DockPanel.Dock="Left" Width="90"/>
                                <ComboBox x:Name="OutputFormatCombo" MinWidth="160"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

        </Grid>
    </Grid>
</UserControl>